local InventoryDirty = false

local InventoryState = {
    Pets = {},
    StrongestPet = nil,
    RoseWolf = 0,
}

task.spawn(function()
    while true do
    if not GardenRunning() then
        task.wait(1)
        continue
    end
        local placedCount = {}
        local totalPlaced = 0
        for _, tower in pairs(TowerCache) do
            totalPlaced = totalPlaced + 1
            placedCount[tower.Name] = (placedCount[tower.Name] or 0) + 1
        end

	_G.GardenPlacedPets = totalPlaced

        local pets = {}
        local roseWolf = 0

        for uid, pet in pairs(SaveCache.Inventory.Tower or {}) do
            if pet.id == "Rose Wolf" then
                roseWolf += pet._am or 1
            end

            local data = PetData[pet.id]
            if data then
                local amount = (pet._am or 1) - (placedCount[pet.id] or 0)
                if amount > 0 then
                    table.insert(pets,{
                        UID = uid,
                        Name = pet.id,
                        Power = data.Power,
                        Amount = amount,
                    })
                end
            end
        end

        table.sort(pets,function(a,b)
            if a.Power == b.Power then
                return a.Amount > b.Amount
            end
            return a.Power > b.Power
        end)

        local changed = false
        if #pets ~= #InventoryState.Pets then
            changed = true
        else
            for i = 1,#pets do
                local a = pets[i]
                local b = InventoryState.Pets[i]
                if not b
                or a.UID ~= b.UID
                or a.Amount ~= b.Amount
                or a.Power ~= b.Power then
                    changed = true
                    break
                end
            end
        end

	InventoryState.RoseWolf = roseWolf

        if changed then
            InventoryState.Pets = pets
            InventoryState.StrongestPet = pets[1]
            InventoryDirty = true
        end
        task.wait(0.25)
    end
end)

-- GARDEN STATE

local GardenDirty = false

local GardenState = {
    Slots = {},
    EmptySlots = {},
    WeakestTower = nil,
}

task.spawn(function()
    while true do
    if not GardenRunning() then
        task.wait(1)
        continue
    end
        local slots = {}
        local occupied = {}
        local weakestTower

        for _, tower in pairs(TowerCache) do
            if tower.CFrame then
                local bestLane
                local bestSlot
                local bestDistance = math.huge
                for lane, laneData in pairs(Lanes) do
                    for slot, slotCF in ipairs(laneData.Slots) do
                        local distance = (tower.CFrame.Position - slotCF.Position).Magnitude
                        if distance < bestDistance then
                            bestDistance = distance
                            bestLane = lane
                            bestSlot = slot
                        end
                    end
                end

                if bestLane and bestDistance < 1 then
                    local power = PetData[tower.Name] and PetData[tower.Name].Power or 0
                    local info = {
                        Lane = bestLane,
                        Slot = bestSlot,
                        UID = tower.UID,
                        Name = tower.Name,
                        Power = power,
                        EntityId = tower.EntityId,
                        Upgrade = tower.Upgrade,
                    }
                    slots[bestLane] = slots[bestLane] or {}
                    slots[bestLane][bestSlot] = info
                    occupied[bestLane] = occupied[bestLane] or {}
                    occupied[bestLane][bestSlot] = true
                    if not weakestTower
                    or power < weakestTower.Power then
                        weakestTower = info
                    end
                end
            end
        end

        local emptySlots = {}
        for lane, laneData in pairs(Lanes) do
            occupied[lane] = occupied[lane] or {}
            for slot, slotCF in ipairs(laneData.Slots) do
                if not occupied[lane][slot] then
                    table.insert(emptySlots, {
                        Lane = lane,
                        Slot = slot,
                        CFrame = slotCF,
                    })
                end
            end
        end

        local changed = false
        if #emptySlots ~= #GardenState.EmptySlots then
            changed = true

        elseif (weakestTower and GardenState.WeakestTower and weakestTower.UID ~= GardenState.WeakestTower.UID)
            or (weakestTower and not GardenState.WeakestTower)
            or (not weakestTower and GardenState.WeakestTower) then
            changed = true

        else

            for lane, laneData in pairs(Lanes) do
                for slot = 1, #laneData.Slots do
                    local a = slots[lane] and slots[lane][slot]
                    local b = GardenState.Slots[lane] and GardenState.Slots[lane][slot]
                    if (not a) ~= (not b) then
                        changed = true
                        break
                    end

                    if a and b then
                        if a.UID ~= b.UID
                        or a.Power ~= b.Power
                        or a.Upgrade ~= b.Upgrade then
                            changed = true
                            break
                        end
                    end
                end
                if changed then
                    break
                end
            end
        end

        if changed then
            GardenState.Slots = slots
            GardenState.EmptySlots = emptySlots
            GardenState.WeakestTower = weakestTower
            GardenDirty = true
        end
        task.wait(0.25)
    end
end)

