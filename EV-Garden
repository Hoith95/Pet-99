-- AUTO HATCH

local CustomEggs = workspace.__THINGS:WaitForChild("CustomEggs")

local CustomEggsCmds = require(Client.CustomEggsCmds)
local CalcEggPrice = require(ReplicatedStorage.Library.Balancing.CalcEggPrice)

local HatchState = {
    EggName = nil,
    EggModel = nil,
    EggPrice = 0,
    MaxHatch = 0,
    NeedCurrency = 0,
}

-- UPDATE EGG

local function UpdateEgg()

    local foundName
    local foundModel

    local root = getRoot()
    local nearestDistance = math.huge

    for _, egg in ipairs(CustomEggs:GetChildren()) do
        if not egg.Name:find(" ")
        and #egg.Name >= 15 then

            local part =
                egg.PrimaryPart
                or egg:FindFirstChildWhichIsA("BasePart", true)

            if part then
                local distance =
                    (root.Position - part.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    foundName = egg.Name
                    foundModel = egg
                end
            end
        end
    end

    if foundModel then
        --print(string.format("[Egg] Selected %s (%.1f studs)",foundName,nearestDistance))
    end

    if foundName == HatchState.EggName then
        return
    end

    HatchState.EggName = foundName
    HatchState.EggModel = foundModel

    HatchState.EggPrice = 0
    HatchState.MaxHatch = 0
    HatchState.NeedCurrency = 0

    if not foundName then
        return
    end

    local info = CustomEggsCmds.All()[foundName]
    if not info then
        return
    end

    HatchState.EggPrice = CalcEggPrice(info._dir)
    HatchState.MaxHatch = EggCmds.GetMaxHatch()
    HatchState.NeedCurrency =
        HatchState.EggPrice * HatchState.MaxHatch

    --print(string.format("[Egg] %s | Price: %s | Max: %d | Need: %s",foundName,HatchState.EggPrice,HatchState.MaxHatch,HatchState.NeedCurrency))
end

-- SCANNER

task.spawn(function()
    while true do
    if not GardenRunning() then
        task.wait(1)
        continue
    end
        UpdateEgg()
        task.wait(2)
    end
end)

