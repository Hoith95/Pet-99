                end)

                task.wait(1.1)

                if (SaveCache.EventUpgrades.GardenBetterEggs or 0) > GARDEN_EGGS_MAX then
                    GardenEggsChecked = false
                    continue
                end
            end

            -- OTHER UPGRADES

            for _, name in ipairs(UPGRADE_ORDER) do
                local level = SaveCache.EventUpgrades[name] or 0

                if level < UPGRADE_TARGET[name] then
                    pcall(function()
                        UpgradeRemote:InvokeServer(name)
                    end)

                    task.wait(1.1)
                    break
                end
            end
        end

        -- HATCH

        if HatchState.EggName
        and SaveCache.Sunflowers >= HatchState.NeedCurrency then
            pcall(function()
                HatchRemote:InvokeServer(
                    HatchState.EggName,
                    HatchState.MaxHatch
                )
            end)
        end

        task.wait(0.1)
    end
end)

-- AUTO REBIRTH

local RebirthRemote = ReplicatedStorage.Network.WK_Reclaim

task.spawn(function()
    repeat
        task.wait()
    until HatchReady

    local TARGET_REBIRTH = 6
    local NEED_ROSE = 63

    while true do
    if not GardenRunning() then
        task.wait(1)
        continue
    end
        local rebirth = _G.GardenRebirth or 0
        if rebirth >= TARGET_REBIRTH then
            --print(string.format("[REBIRTH] Reached target: %d/%d",rebirth,TARGET_REBIRTH))
            task.wait(10)
            continue
        end

        if not AllGardenUpgradesDone() then
            --print("[REBIRTH] Waiting upgrades...")
            task.wait(5)
            continue
        end

        if InventoryState.RoseWolf < NEED_ROSE then
            --print(string.format("[REBIRTH] Rose Wolf: %d/%d",InventoryState.RoseWolf,NEED_ROSE))
            task.wait(5)
            continue
        end

        --print(string.format("[REBIRTH] Sending... (Rebirth=%d)",rebirth))

        local old = rebirth

        local ok, err = pcall(function()
            RebirthRemote:InvokeServer()
        end)

        if not ok then
            warn("[REBIRTH] Invoke failed:", err)
            task.wait(5)
            continue
        end

        task.wait(3)

        local newRebirth = _G.GardenRebirth or 0

        if newRebirth > old then
            GardenEggsChecked = false
            --print(string.format("[REBIRTH] Success! %d -> %d",old,newRebirth))
            task.wait(2)
        else
            warn(string.format("[REBIRTH] Failed! (%d -> %d)",old,newRebirth))
            task.wait(300)
        end
    end
end)

-- AUTO PROMOTE GARDEN GOLEM

local PromoteRemote = ReplicatedStorage.Network.EK_Promote

task.spawn(function()
    repeat
        task.wait()
    until HatchReady

    while true do
    if not GardenRunning() then
        task.wait(1)
        continue
    end
        if (SaveCache.RebirthStage or 0) < 2 then
            task.wait(5)
            continue
        end

        if SaveCache.Sunflowers < 150000000 then
            task.wait(5)
            continue
        end

        local found = false

        for _, tower in pairs(TowerCache) do
            if tower.Name == "Garden Golem" then
                local upgrade = tonumber(tower.Upgrade)
                if upgrade then
                    PromoteRetry[tower.EntityId] = nil
                    if upgrade >= 10 then
                        continue
                    end
                else
                    PromoteRetry[tower.EntityId] = (PromoteRetry[tower.EntityId] or 0) + 1

                    if PromoteRetry[tower.EntityId] > 10 then
                        continue
                    end
                end

                found = true

                --print(("[Promote] Entity=%s | Upgrade=%s"):format(tostring(tower.EntityId),tostring(tower.Upgrade)))

                local ok, err = pcall(function()
                    PromoteRemote:InvokeServer(tower.EntityId)
                end)

                if ok then
                    --print("[Promote] Success")
                else
                    warn("[Promote] Failed:", err)
                end
                task.wait(0.2)
            end
        end

        if not found then
            --print("[Promote] Waiting Garden Golem...")
            task.wait(1)
        else
            task.wait(0.1)
        end
    end
end)
