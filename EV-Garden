-- TOWER CACHE

local TowerCache = {}
local PromoteRetry = {}

-- TOWER SCANNER

task.spawn(function()
    local network = ReplicatedStorage.Network
    local TowerDefense = network:FindFirstChild("TowerDefense")
    if not TowerDefense then
        repeat
            TowerDefense = network.ChildAdded:Wait()
        until TowerDefense.Name == "TowerDefense"
    end

    TowerDefense.OnClientEvent:Connect(function(packets)
        for _, packet in ipairs(packets) do
            local td = packet.Payload
                and packet.Payload.Entities
                and packet.Payload.Entities.Tower
            if not td then
                continue
            end

            -- Creates

            if td.Creates then
                for index, tower in ipairs(td.Creates) do
                    local state = tower.Save.State
                    TowerCache[tower.Id] = {
                        Index = index,
                        EntityId = tower.Id,
                        UID = state.Item.uid,
                        Name = state.Item.data.id,
                        Upgrade = state.Upgrade,
                        Target = state.TargetSelection,
                        CFrame = state.LocalCFrame,
                        State = state
                    }
                end
            end

            -- Updates

            if td.Updates then
                for i, update in ipairs(td.Updates) do
                    local entity = td.UpdateIds[i]
                    local cache = TowerCache[entity]
                    if cache then
                        for key, value in pairs(update) do
                            cache.State[key] = value
                        end
                        cache.Upgrade = cache.State.Upgrade
                        cache.Target = cache.State.TargetSelection
                        cache.CFrame = cache.State.LocalCFrame
                    end
                end
            end

            -- Destroys

            if td.Destroys then
                local ok, err = pcall(function()
                    for _, entity in ipairs(td.Destroys) do
                        TowerCache[entity] = nil
                        PromoteRetry[entity] = nil
                    end
                end)

                if not ok then
                    warn("[Destroy Error]", err)
                end
            end
        end
    end)
    --print("[Tower] Scanner Started")
end)

