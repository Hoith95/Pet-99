if _G.VAR_TIME_TRIAL_CLAIM then return end
_G.VAR_TIME_TRIAL_CLAIM = true

repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

repeat task.wait() until player
repeat task.wait() until not player.PlayerGui:FindFirstChild("__INTRO")

-- ================= SAVE =================

local Save = require(ReplicatedStorage.Library.Client.Save)

-- ================= GET DATA =================

local function safeFetchSave()
    for i = 1, 3 do
        local ok, data = pcall(Save.Get)
        if ok and data and data.TimeTrialStats then
            return data.TimeTrialStats
        end
        task.wait(1)
    end

    return {
        DailyRuns = 0,
        Points = 0,
        TotalRuns = 0,
    }
end

local function getTimeTrialPoints()
    local stats = safeFetchSave()
    return stats.Points or 0
end

-- ================= LUCKY BREAKOUT =================

local function isLuckyBreakout()
    local things = workspace:FindFirstChild("__THINGS")
    local container = things and things:FindFirstChild("__INSTANCE_CONTAINER")
    local active = container and container:FindFirstChild("Active")

    return active and active:FindFirstChild("LuckyBreakout") ~= nil
end

local function waitUntilNotLuckyBreakout()
    while isLuckyBreakout() do
        task.wait(1)
    end
end

-- ================= TELEPORT =================

local function getHumanoidRootPart()
    local character = player.Character or player.CharacterAdded:Wait()
    if not character then return nil end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local waitTime = 0

    while not hrp and waitTime < 5 do
        task.wait(0.5)
        waitTime += 0.5
        hrp = character:FindFirstChild("HumanoidRootPart")
    end

    return hrp
end

local function teleportToRewardLocation()
    local hrp = getHumanoidRootPart()
    if hrp then
        hrp.CFrame = CFrame.new(-15079, 16.24, 2165)
    end
end

local function teleportToLocation()
    local hrp = getHumanoidRootPart()
    if hrp then
        hrp.CFrame = CFrame.new(-15045, 24.24, 2201)
    end
end

-- ================= ĐỔI QUÀ =================

local function claimReward()
    waitUntilNotLuckyBreakout()

    local points = getTimeTrialPoints()

    local now = os.date("!*t", os.time(os.date("!*t")) + 7 * 3600)
    local currentDay = now.wday
    local currentHour = now.hour
    local isSaturdayFull = (currentDay == 3 or currentDay == 7) and (currentHour < 23)

    local chest3, chest2, chest1 = 0, 0, 0

    if isSaturdayFull then
        chest3 = math.floor(points / 5000)
        points = points - chest3 * 5000
        chest2 = math.floor(points / 3000)
        points = points - chest2 * 3000
        chest1 = math.floor(points / 1000)
    else
        chest3 = math.floor(points / 5000)
    end

    local totalChests = chest3 + chest2 + chest1
    if totalChests == 0 then
        return
    end

    local function openChest(chestType)
        local args = {
            [1] = chestType
        }
        return ReplicatedStorage.Network.TimeTrials_OpenChest:InvokeServer(unpack(args))
    end

    local function isAtExactRewardPosition()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        local target = Vector3.new(-15079, 16.24, 2165)
        return (hrp.Position - target).Magnitude <= 2
    end

    local function claimMultiple(count, chestType)
        for i = 1, count do
            waitUntilNotLuckyBreakout()

            if not isAtExactRewardPosition() then
                teleportToRewardLocation()
                task.wait(3)

                if not isAtExactRewardPosition() then
                    return
                end
            end

            local success, err = pcall(function()
                openChest(chestType)
            end)

            if not success then
                return
            end

            task.wait(3)

            if not isAtExactRewardPosition() then
                teleportToRewardLocation()
                task.wait(3)

                if not isAtExactRewardPosition() then
                    return
                end
            end
        end
    end

    local retry = 0

    while retry < 3 do
        waitUntilNotLuckyBreakout()

        retry += 1
        teleportToRewardLocation()
        task.wait(3)

        if isAtExactRewardPosition() then
            break
        end
    end

    if not isAtExactRewardPosition() then
        return
    end

    claimMultiple(chest3, 3)
    claimMultiple(chest2, 2)
    claimMultiple(chest1, 1)

    task.wait(3)
    teleportToLocation()
end

-- ================= AUTO CLAIM =================

task.spawn(function()
    task.wait(5)

    while true do
        waitUntilNotLuckyBreakout()

        local points = getTimeTrialPoints()
        local now = os.date("!*t", os.time(os.date("!*t")) + 7 * 3600)

        local canClaim = (now.wday == 3 and now.hour < 23 and points >= 1000)
            or (now.wday ~= 3 and points >= 5000)

        if canClaim then
            claimReward()
        end

        task.wait(15 * 60)
    end
end)
