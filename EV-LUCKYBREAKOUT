-- ===========- AUTO UPGRADE -===========

task.spawn(function()
    repeat
        task.wait(5)
    until HatchReady

    local UpgradeRemote =
        ReplicatedStorage.Network:WaitForChild(
            "EventUpgrades: Purchase"
        )

    local UpgradeList = {
        "LuckyBreakoutEggTier",
        "LuckyBreakoutGiftDrops",
        "LuckyBreakoutBuxBonus",
        "LuckyBreakoutBallPower",
        "LuckyBreakoutBallSpeed"
    }

    local function getBreakoutBucks()
        local sd = getSave()

        if not sd
            or not sd.Inventory
            or not sd.Inventory.Currency then
            return 0
        end

        for _, currency in pairs(sd.Inventory.Currency) do
            if currency.id == "BreakoutBucks" then
                return tonumber(currency._am) or 0
            end
        end

        return 0
    end

    while true do
        if not LuckyBreakoutRunning() then
            task.wait(1)
            continue
        end

        if getBreakoutBucks() > 550 then
            for _, upgradeId in ipairs(UpgradeList) do
                if not LuckyBreakoutRunning() then
                    break
                end

                if getBreakoutBucks() <= 550 then
                    break
                end

                pcall(function()
                    UpgradeRemote:InvokeServer(upgradeId)
                end)

                task.wait(0.2)
            end
        end

        task.wait(2)
    end
end)
