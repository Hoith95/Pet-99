if _G.VAR_LUCKYBREAKOUT then
    return
end

_G.VAR_LUCKYBREAKOUT = true

-- ===========- SERVICES -===========

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local Client = ReplicatedStorage:WaitForChild("Library"):WaitForChild("Client")
local EggCmds = require(Client.EggCmds)
local PlayerSave = require(Client.Save)

local function getSave()
    return PlayerSave.Get()
end

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

-- ===========- TIME TRIAL STATE -===========

local function LuckyBreakoutRunning()
    return _G.Time_Trial_End == true
end

-- ===========- WAIT UNTIL EGGS HATCHED INCREASES -===========

local function getEggsHatched()
    local sd = getSave()
    if not sd then
        return nil
    end
    return tonumber(sd.EggsHatched) or 0
end

local lastEggs

repeat
    lastEggs = getEggsHatched()
    task.wait(1)
until lastEggs ~= nil

repeat
    task.wait(1)

    local currentEggs = getEggsHatched()

    if currentEggs
        and currentEggs > lastEggs then
        break
    end
until false

-- ===========- TELEPORT TO EVENT -===========

local HatchReady = false

repeat
    task.wait(2)
until _G.Time_Trial_End == true

task.wait(68)

getRoot().CFrame = CFrame.new(-15849, 40.27, -195)

repeat
    task.wait(5)
until workspace.__THINGS.__INSTANCE_CONTAINER.Active:FindFirstChild("LuckyBreakout")

task.wait(20)

-- ===========- AUTO SETTINGS -===========

local function getLuckyBreakoutRebirths()
    local sd = getSave()

    return sd
        and sd.InstanceVars
        and sd.InstanceVars.LuckyBreakout
        and tonumber(sd.InstanceVars.LuckyBreakout.Rebirths)
        or 0
end

local function setAuto(rebirths)
    local autoRebirth = rebirths < 125

    ReplicatedStorage.Network.Instancing_FireCustomFromClient:FireServer(
        "LuckyBreakout",
        "LBSetAutoRebirth",
        autoRebirth
    )

    ReplicatedStorage.Network.Instancing_FireCustomFromClient:FireServer(
        "LuckyBreakout",
        "LBSetAutoBuySlots",
        false
    )
end

setAuto(getLuckyBreakoutRebirths())

task.spawn(function()
    local lastRebirth = getLuckyBreakoutRebirths()

    while true do
        local rebirths = getLuckyBreakoutRebirths()

        if rebirths ~= lastRebirth then
            lastRebirth = rebirths
            setAuto(rebirths)
        end
        task.wait(1)
    end
end)

HatchReady = true

-- ===========- EXIT LUCKYBREAKOUT WHEN TIME TRIAL START -===========

task.spawn(function()
    local waitStart

    while true do
        local active =
            workspace.__THINGS.__INSTANCE_CONTAINER.Active

        local inLuckyBreakout =
            active:FindFirstChild("LuckyBreakout") ~= nil

        if _G.Time_Trial_End == false and inLuckyBreakout then
            if not waitStart then
                waitStart = tick()
            end

            if tick() - waitStart >= 180 then
                getRoot().CFrame = CFrame.new(9195, 505, 9810)
                waitStart = nil
            end
        else
            waitStart = nil
        end
        task.wait(2)
    end
end)

-- ===========- RETURN TO LUCKYBREAKOUT AFTER TIME TRIAL -===========

task.spawn(function()
    local waitStart = nil

    while true do
        local inLuckyBreakout =
            workspace.__THINGS.__INSTANCE_CONTAINER.Active:FindFirstChild("LuckyBreakout")

        if _G.Time_Trial_End
            and not inLuckyBreakout then

            if not waitStart then
                waitStart = tick()
            end

            if tick() - waitStart >= 180 then
                getRoot().CFrame = CFrame.new(-15849, 40.27, -195)
                waitStart = nil
            end
        else
