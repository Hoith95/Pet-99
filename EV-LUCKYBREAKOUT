-- ===========- AUTO REDEEM LUCKYBREAKOUT CHESTS -===========

task.spawn(function()
    repeat
        task.wait(5)
    until HatchReady

    local function hasKey(keyName)
        local sd = getSave()

        if not sd
            or not sd.Inventory
            or not sd.Inventory.Misc then
            return false
        end

        for _, item in pairs(sd.Inventory.Misc) do
            if item.id == keyName then
                return true
            end
        end

        return false
    end

    local function unlockTitanic()
        if not hasKey("Lucky Titanic Key") then
            return
        end

        ChestKeyTeleporting = true
        EggTeleporting = true

        getRoot().CFrame = CFrame.new(9154, 510, 9577)
        task.wait(1)

        while hasKey("Lucky Titanic Key") do
            local args = {
                [1] = 1
            }

            pcall(function()
                game:GetService("ReplicatedStorage").Network.LuckyTitanicKey_Unlock:InvokeServer(unpack(args))
            end)

            task.wait(1)
        end
    end

    local function unlockGargantuan()
        if not hasKey("Lucky Gargantuan Key") then
            return
        end

        ChestKeyTeleporting = true
        EggTeleporting = true

        getRoot().CFrame = CFrame.new(9259, 510, 9578)
        task.wait(1)

        while hasKey("Lucky Gargantuan Key") do
            local args = {
                [1] = 1
            }

            pcall(function()
                game:GetService("ReplicatedStorage").Network.LuckyGargantuanKey_Unlock:InvokeServer(unpack(args))
            end)

            task.wait(1)
        end
    end

    while true do
        if LuckyBreakoutRunning() then
            local hasTitanic = hasKey("Lucky Titanic Key")
            local hasGargantuan = hasKey("Lucky Gargantuan Key")

            if hasTitanic or hasGargantuan then
                ChestKeyTeleporting = true
                EggTeleporting = true

                if hasTitanic then
                    unlockTitanic()
                end

                task.wait(1)

                if hasGargantuan then
                    unlockGargantuan()
                end

                task.wait(1)

                ChestKeyTeleporting = false
                EggTeleporting = false
            end
        end

        task.wait(2)
    end
end)

