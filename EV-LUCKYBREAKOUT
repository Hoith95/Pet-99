    local autoRebirth = rebirths < 5

    ReplicatedStorage.Network.Instancing_FireCustomFromClient:FireServer(
        "LuckyBreakout",
        "ZP_Cycle",
        autoRebirth
    )
end

local function setGCYield()
    ReplicatedStorage.Network.Instancing_FireCustomFromClient:FireServer(
        "LuckyBreakout",
        "GC_Yield",
        true
    )
end

local rebirths = getLuckyBreakoutRebirths()

setAuto(rebirths)

if rebirths >= 1 then
    setGCYield()
end

task.spawn(function()
    local lastRebirth = rebirths
    local GCYieldSet = rebirths >= 1

    while true do
        local rebirths = getLuckyBreakoutRebirths()

        if rebirths ~= lastRebirth then
            lastRebirth = rebirths
            setAuto(rebirths)
        end

        if not GCYieldSet and rebirths >= 1 then
            GCYieldSet = true
            setGCYield()
        end

        task.wait(1)
    end
end)

