if _G.VAR_LUCKYBREAKOUT then
    return
end

_G.VAR_LUCKYBREAKOUT = true

-- ===========- SERVICES -===========

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local Client = ReplicatedStorage:WaitForChild("Library"):WaitForChild("Client")
local EggCmds = require(Client.EggCmds)
local PlayerSave = require(Client.Save)

local function getSave()
    return PlayerSave.Get()
end

local function getBreakoutCoins()
    local sd = getSave()

    if not sd
        or not sd.Inventory
        or not sd.Inventory.Currency then
        return 0
    end

    for _, currency in pairs(sd.Inventory.Currency) do
        if currency.id == "BreakoutCoins" then
            return tonumber(currency._am) or 0
        end
    end

    return 0
end

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

-- ===========- TIME TRIAL STATE -===========

local function LuckyBreakoutRunning()
    return _G.Time_Trial_End == true
end

-- ===========- WAIT UNTIL EGGS HATCHED INCREASES -===========

local function getEggsHatched()
    local sd = getSave()

    if not sd then
        return nil
    end

    return tonumber(sd.EggsHatched) or 0
end

local lastEggs

repeat
    lastEggs = getEggsHatched()
    task.wait(1)
until lastEggs ~= nil

repeat
    task.wait(1)

    local currentEggs = getEggsHatched()

    if currentEggs
        and currentEggs > lastEggs then
        break
    end
until false

