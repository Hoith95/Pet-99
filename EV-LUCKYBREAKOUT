                            [2] = 1
                        }

                        Consumables_Consume:InvokeServer(unpack(args))
                    end)

                    task.wait(1)
                end
            end
        end
    end

    while true do
        if LuckyBreakoutRunning() then
            useBoostPotion()
        end
        task.wait(5)
    end
