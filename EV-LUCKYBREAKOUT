local function getRebirths()
    local sd = getSave()

    return sd
        and sd.InstanceVars
        and sd.InstanceVars.LuckyBreakout
        and tonumber(sd.InstanceVars.LuckyBreakout.Rebirths2)
        or 0
end

local function getMaxLevel()
    local sd = getSave()

    return sd
        and sd.InstanceVars
        and sd.InstanceVars.LuckyBreakout
        and tonumber(sd.InstanceVars.LuckyBreakout.MaxLevel2)
        or 0
end

local function getNextCost(name)
    local level = getUpgradeLevel(name)
    local costs = UpgradeCosts[name]
    local maxTier = MaxTiers[name]

    if maxTier and level >= maxTier then
        return nil
    end

    if not costs then
        return nil
    end

    local nextLevel = level + 1

    if nextLevel > #costs then
        return nil
    end

    return costs[nextLevel]
end

local function getNextNSlotCost(slots, amount)
    local total = 0
    local count = 0

    for level = slots + 1, math.min(slots + amount, #BoardSlotsCosts) do
        total += BoardSlotsCosts[level]
        count += 1
    end

    if count < amount then
        return nil
    end

    return total
end

local function getNext10SlotCost(slots)
    return getNextNSlotCost(slots, 10)
end

local function getNext15SlotCost(slots)
    return getNextNSlotCost(slots, 15)
end

local function purchaseUpgrade(name)
    pcall(function()
        UpgradeRemote:InvokeServer(name)
    end)

    task.wait(0.5)
end

-- ===========- PERMANENT UPGRADES -===========

local function checkPermanentUpgrades(bucks, rebirths)
    local eggTier = getUpgradeLevel("LuckyBreakoutEggTier")

    if rebirths >= 25 and eggTier < 4 then
        local cost = getNextCost("LuckyBreakoutEggTier")

        if cost and cost <= bucks then
            purchaseUpgrade("LuckyBreakoutEggTier")
            return true
        end
    end

    if rebirths >= 80 and eggTier < 8 then
        local cost = getNextCost("LuckyBreakoutEggTier")

        if cost and cost <= bucks then
            purchaseUpgrade("LuckyBreakoutEggTier")
            return true
        end
    end

    return false
end

-- ===========- EARLY MAX LEVEL 1 PRIORITY -===========

local function checkEarlyMaxLevelOne(bucks, rebirths, maxLevel)
    if rebirths < 100 or maxLevel ~= 1 then
        return false
    end

    local power = "LuckyBreakoutBallPower"
    local speed = "LuckyBreakoutBallSpeed"

    local powerLevel = getUpgradeLevel(power)
    local speedLevel = getUpgradeLevel(speed)

    if powerLevel < 3 then
        local cost = getNextCost(power)

        if cost and cost <= bucks then
            purchaseUpgrade(power)
            return true
        end
    end

    if speedLevel < 3 then
        local cost = getNextCost(speed)

        if cost and cost <= bucks then
            purchaseUpgrade(speed)
            return true
        end
    end

    local slots = getUpgradeLevel("LuckyBreakoutBoardSlots")

    if slots < 100 then
        local cost = BoardSlotsCosts[slots + 1]

        if cost and cost <= bucks then
            purchaseUpgrade("LuckyBreakoutBoardSlots")
            return true
        end
    end

    return false
end

-- ===========- COMBAT / SLOT BALANCE -===========

local function checkBoardAndCombat(bucks, maxLevel)
    local slots = getUpgradeLevel("LuckyBreakoutBoardSlots")

    if slots >= 100 then
        return false
    end

    if maxLevel <= 40 then
        local target = math.floor(slots / 10)

        if target < 1 then
            target = 1
        end

        if target > 10 then
            target = 10
        end

        local missingCombat = {}

        for _, name in ipairs(CombatUpgrades) do
            local level = getUpgradeLevel(name)

            if level < target then
                local cost = getNextCost(name)

                if cost then
                    table.insert(missingCombat, {
                        name = name,
                        level = level,
                        cost = cost
                    })
                end
            end
        end

        if #missingCombat > 0 then
            local cheapestCombat = missingCombat[1]

            for _, item in ipairs(missingCombat) do
                if item.cost < cheapestCombat.cost then
                    cheapestCombat = item
                end
            end

            if cheapestCombat.cost <= bucks then
                purchaseUpgrade(cheapestCombat.name)
                return true
            end

            return false
        end

        if BoardSlotsCosts[slots + 1] and BoardSlotsCosts[slots + 1] <= bucks then
            purchaseUpgrade("LuckyBreakoutBoardSlots")
            return true
        end

        return false
    end

    local target = math.floor(slots / 10)

    if target < 1 then
        target = 1
    end

    if target > 10 then
        target = 10
    end

    local missingCombat = {}

    for _, name in ipairs(CombatUpgrades) do
        local level = getUpgradeLevel(name)

        if level < target then
            local cost = getNextCost(name)

            if cost then
                table.insert(missingCombat, {
                    name = name,
                    level = level,
                    cost = cost
                })
            end
        end
    end

    if #missingCombat > 0 then
        local next10Cost = getNext10SlotCost(slots)
        local cheapestCombat = missingCombat[1]

        for _, item in ipairs(missingCombat) do
            if item.cost < cheapestCombat.cost then
                cheapestCombat = item
            end
        end

        if cheapestCombat.cost <= bucks
            and next10Cost
            and cheapestCombat.cost < next10Cost then

            purchaseUpgrade(cheapestCombat.name)
            return true
        end

        if cheapestCombat.cost <= bucks
            and (not next10Cost or next10Cost > bucks) then

            purchaseUpgrade(cheapestCombat.name)
            return true
        end
    end

    local allCombatReady = true

    for _, name in ipairs(CombatUpgrades) do
        if getUpgradeLevel(name) < target then
            allCombatReady = false
            break
        end
    end

    if not allCombatReady then
        return false
    end

    local next10Cost = getNext10SlotCost(slots)

    if not next10Cost then
        return false
    end

    if next10Cost > bucks then
        local cheapestCombat
        local cheapestCost = math.huge

        for _, name in ipairs(CombatUpgrades) do
            local cost = getNextCost(name)

            if cost and cost < cheapestCost and cost <= bucks then
                cheapestCost = cost
                cheapestCombat = name
            end
        end

        if cheapestCombat then
            purchaseUpgrade(cheapestCombat)
            return true
        end

        return false
    end

    local cheaperCombat = nil
    local cheaperCombatCost = math.huge

    for _, name in ipairs(CombatUpgrades) do
        local cost = getNextCost(name)

        if cost
            and cost < next10Cost
            and cost <= bucks
            and cost < cheaperCombatCost then

            cheaperCombatCost = cost
            cheaperCombat = name
        end
    end

    if cheaperCombat then
        purchaseUpgrade(cheaperCombat)
        return true
    end

    if BoardSlotsCosts[slots + 1] and BoardSlotsCosts[slots + 1] <= bucks then
        purchaseUpgrade("LuckyBreakoutBoardSlots")
        return true
    end

    return false
end

-- ===========- ECONOMY -===========

local function checkEconomyUpgrades(bucks)
    local buxLevel = getUpgradeLevel("LuckyBreakoutBuxBonus")
    local giftLevel = getUpgradeLevel("LuckyBreakoutGiftDrops")

    local buxCost = getNextCost("LuckyBreakoutBuxBonus")
    local giftCost = getNextCost("LuckyBreakoutGiftDrops")

    if buxLevel < 3
        and buxCost
        and buxCost <= bucks then

        purchaseUpgrade("LuckyBreakoutBuxBonus")
        return true
    end

    if giftLevel < 3
        and giftCost
        and giftCost <= bucks then

        purchaseUpgrade("LuckyBreakoutGiftDrops")
        return true
    end

    return false
end

-- ===========- MAX ALL -===========

local function checkMaxAll(bucks)
    local UpgradeList = {
        "LuckyBreakoutBoardSlots",
        "LuckyBreakoutBallPower",
        "LuckyBreakoutBallSpeed",
        "LuckyBreakoutBuxBonus",
        "LuckyBreakoutEggTier",
        "LuckyBreakoutGiftDrops",
        "LuckyBreakoutBlasterRate",
        "LuckyBreakoutBlasterDamage",
        "LuckyBreakoutBumperSlots"
    }

    for _, name in ipairs(UpgradeList) do
        local level = getUpgradeLevel(name)
        local maxTier = MaxTiers[name]

        if maxTier and level < maxTier then
            local cost = getNextCost(name)

            if cost and cost <= bucks then
                purchaseUpgrade(name)
                return true
            end
        end
    end

    return false
end

-- ===========- MAIN LOOP -===========

task.spawn(function()
    while true do
        local bucks = getBreakoutBucks()
        local rebirths = getRebirths()
        local maxLevel = getMaxLevel()

        if bucks > 0 then
            if checkEarlyMaxLevelOne(bucks, rebirths, maxLevel) then
                continue
            end

            if checkPermanentUpgrades(bucks, rebirths) then
                continue
            end

            if checkBoardAndCombat(bucks, maxLevel) then
                continue
            end

            if checkEconomyUpgrades(bucks) then
                continue
            end

            if checkMaxAll(bucks) then
                continue
            end
        end

        task.wait(1)
    end
end)

