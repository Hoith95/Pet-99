-- ===========- AUTO UPGRADE -===========

task.spawn(function()
    repeat
        task.wait(5)
    until HatchReady

    local UpgradeRemote =
        ReplicatedStorage.Network:WaitForChild("EventUpgrades: Purchase")

    local function getEventUpgrades()
        local sd = getSave()
        if not sd then
            return {}
        end
        return sd.EventUpgrades or {}
    end

    local function getUpgradeLevel(name)
        return tonumber(getEventUpgrades()[name]) or 0
    end

    local function purchaseUpgrade(name)
        pcall(function()
            UpgradeRemote:InvokeServer(name)
        end)

        task.wait(0.5)
    end

    while true do
        if not LuckyBreakoutRunning() then
            task.wait(1)
            continue
        end

        -- ===========- BOARD SLOTS → 20 -===========

        local boardSlots =
            getUpgradeLevel("LuckyBreakoutBoardSlots")

        if boardSlots < 20 then
            purchaseUpgrade("LuckyBreakoutBoardSlots")
            continue
        end

        -- ===========- BALL POWER / SPEED → 3 -===========

        local ballPower =
            getUpgradeLevel("LuckyBreakoutBallPower")

        local ballSpeed =
            getUpgradeLevel("LuckyBreakoutBallSpeed")

        if ballPower < 3 then
            purchaseUpgrade("LuckyBreakoutBallPower")
            continue
        end

        if ballSpeed < 3 then
            purchaseUpgrade("LuckyBreakoutBallSpeed")
            continue
        end

        -- ===========- BOARD SLOTS → 30 -===========

        boardSlots =
            getUpgradeLevel("LuckyBreakoutBoardSlots")

        if boardSlots < 30 then
            purchaseUpgrade("LuckyBreakoutBoardSlots")
            continue
        end

        -- ===========- GIFT DROPS → 3 -===========

        local giftDrops =
            getUpgradeLevel("LuckyBreakoutGiftDrops")

        if giftDrops < 3 then
            purchaseUpgrade("LuckyBreakoutGiftDrops")
            continue
        end

        -- ===========- BALL POWER / SPEED → 4 -===========

        ballPower =
            getUpgradeLevel("LuckyBreakoutBallPower")

        ballSpeed =
            getUpgradeLevel("LuckyBreakoutBallSpeed")

        if ballPower < 4 then
            purchaseUpgrade("LuckyBreakoutBallPower")
            continue
        end

        if ballSpeed < 4 then
            purchaseUpgrade("LuckyBreakoutBallSpeed")
            continue
        end

        -- ===========- BOARD SLOTS → 40 -===========

        boardSlots =
            getUpgradeLevel("LuckyBreakoutBoardSlots")

        if boardSlots < 40 then
            purchaseUpgrade("LuckyBreakoutBoardSlots")
            continue
        end

        -- ===========- ALL MAIN UPGRADES → 5 -===========

        giftDrops =
            getUpgradeLevel("LuckyBreakoutGiftDrops")

        ballPower =
            getUpgradeLevel("LuckyBreakoutBallPower")

        ballSpeed =
            getUpgradeLevel("LuckyBreakoutBallSpeed")

        if giftDrops < 5 then
            purchaseUpgrade("LuckyBreakoutGiftDrops")
            continue
        end

        if ballPower < 5 then
            purchaseUpgrade("LuckyBreakoutBallPower")
            continue
        end

        if ballSpeed < 5 then
            purchaseUpgrade("LuckyBreakoutBallSpeed")
            continue
        end

        -- ===========- EGG TIER → 4 -===========

        local eggTier =
            getUpgradeLevel("LuckyBreakoutEggTier")

        if eggTier < 4 then
            purchaseUpgrade("LuckyBreakoutEggTier")
            continue
        end

        -- ===========- EVERYTHING → MAX -===========

        local MaxUpgrades = {
            "LuckyBreakoutBoardSlots",
            "LuckyBreakoutBallPower",
            "LuckyBreakoutBallSpeed",
            "LuckyBreakoutGiftDrops",
            "LuckyBreakoutEggTier",
            "LuckyBreakoutBuxBonus"
        }

        for _, upgradeId in ipairs(MaxUpgrades) do
            if not LuckyBreakoutRunning() then
                break
            end
            purchaseUpgrade(upgradeId)
        end
        task.wait(1)
    end
end)
