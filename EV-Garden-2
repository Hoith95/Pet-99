local function NormalizePlantName(name)
    if not name or name == "" then
        return ""
    end

    local prefixes = {
        "Gold",
        "Golden",
        "Rainbow",
        "Shiny",
    }

    local changed = true
    while changed do
        changed = false
        for _, prefix in ipairs(prefixes) do
            local newName = name:gsub("^" .. prefix .. "%s+", "")
            if newName ~= name then
                name = newName
                changed = true
            end
        end
    end
    return name
end

local ParseRate
ParseRate = function(text)
    if type(text) ~= "string" then
        return 0
    end
    text = text:gsub("%s+", "")
    if not text:find("/s", 1, true) then
        return 0
    end
    local num, suffix = text:match("^([%d%.]+)([kKmMbB]?)%/s$")
    if not num then
        return 0
    end
    local value = tonumber(num)
    if not value then
        return 0
    end
    suffix = suffix:lower()
    if suffix == "k" then
        value = value * 1000
    elseif suffix == "m" then
        value = value * 1000000
    elseif suffix == "b" then
        value = value * 1000000000
    end
    return value
end

-- UPDATE PLANT CACHE

local function UpdatePlantCache()
    table.clear(PlantCache)
    PlotState.CropCount = 0
    if not PlotState.PlotId then
        return
    end

    local plot = workspace.__THINGS.Plots:FindFirstChild(
        tostring(PlotState.PlotId)
    )

    if not plot then
        return
    end

    local crops = plot:FindFirstChild("PvC_Crops")
    if not crops then
        return
    end

    for slot = 1, PlotState.UnlockedPlots do
        local crop = crops:FindFirstChild(tostring(slot))
        if crop then
            local timer = crop:FindFirstChild("PvC_GrowTimer")
            if timer then
                local frame = timer.Frame
                local displayNameLabel = frame:FindFirstChild("DisplayName")
                local plantName = displayNameLabel and displayNameLabel.Text or ""
                local lookupName = NormalizePlantName(plantName)
                local rateLabel = frame:FindFirstChild("Rate")
                local rateText = rateLabel and rateLabel.Text or ""
                local rate = ParseRate(rateText)
                local power = PlantPower[lookupName] or 0
                PlantCache[slot] = {
                    Plot = slot,                    
                    Name = plantName,
                    Power = power,
                    Rate = rate,
                }
                PlotState.CropCount += 1
            end
        end
    end
end


