-- HAS CROP

local function HasCrop(slot)
    return GetCrop(slot) ~= nil

end
-- WAIT

local function WaitCropAppear(slot)
    local timeout = os.clock() + 5
    repeat
        if HasCrop(slot) then
            return true
        end
        task.wait(0.1)
    until os.clock() >= timeout
    return false
end

local function WaitCropDisappear(slot)
    local timeout = os.clock() + 5
    repeat
        if not HasCrop(slot) then
            return true
        end
        task.wait(0.1)
    until os.clock() >= timeout
    return false
end

local function WaitPlantIdentified(slot)
    local timeout = os.clock() + 5
    repeat
        UpdatePlantCache()
        local plant = PlantCache[slot]
        if plant and plant.Rate > 0 then
            return true
        end
        task.wait(0.1)
    until os.clock() >= timeout
    return false
end

-- INITIALIZE

local function InitializePlot()
    if not StrongestSeed then
        return false
    end
    if PlotState.CropCount > 0 then
        return false
    end
    if not InsertSeed(1, StrongestSeed.UID) then
        return false
    end
    if not WaitCropAppear(1) then
        return false
    end
    if not WaitPlantIdentified(1) then
        return false
    end
    return true
end
-- AUTO ACQUIRE

local function AutoAcquirePlots()
    if not StrongestSeed then
        return
    end
    if PlotState.UnlockedPlots >= 10 then
        return
    end
    local nextSlot = PlotState.UnlockedPlots + 1
    local info = PlotData[nextSlot]
    if not info or SaveCache.Sunflowers < info.Price then
        return
    end
    if not AcquirePlot(nextSlot) then
        return
    end
    task.wait(0.75)
    UpdateUnlockedPlots()
    UpdateSeedInventory()
    if StrongestSeed and InsertSeed(nextSlot, StrongestSeed.UID) then
        WaitCropAppear(nextSlot)
        WaitPlantIdentified(nextSlot)
        UpdatePlantCache()
    end

end

-- REPLACE

local function ReplacePlant(slot)
    if not StrongestSeed then
        return false
    end
    if not PurgePlant(slot) then
        return false
    end
    if not WaitCropDisappear(slot) then
        return false
    end
    UpdateSeedInventory()
    if not StrongestSeed then
        return false
    end
    if not InsertSeed(slot, StrongestSeed.UID) then
        return false
    end
    if not WaitCropAppear(slot) then
        return false
    end
    if not WaitPlantIdentified(slot) then
        return false
    end
    return true
end

-- AUTO COLLECT

local LastCollect = 0
local function AutoCollect()
    if os.clock() - LastCollect < 60 then
        return
    end
    LastCollect = os.clock()
    for slot = 1, PlotState.UnlockedPlots do
        CollectPlant(slot)
        task.wait(0.05)
    end
end

-- AUTO REPLACE

local function AutoReplacePlants()
    if not StrongestSeed then
        return
    end
    local seed = SeedData[StrongestSeed.Name]
    if not seed then
        return
    end
    while true do
    if not GardenRunning() then
        task.wait(1.5)
        continue
    end
        UpdatePlantCache()
        local weakestSlot
        local weakestPower = math.huge
        for slot = 1, PlotState.UnlockedPlots do
            local plant = PlantCache[slot]
            if not plant then
                if InsertSeed(slot, StrongestSeed.UID) then
                    WaitCropAppear(slot)
                    WaitPlantIdentified(slot)
                    UpdatePlantCache()
                else
                end
                return
            end
            if plant.Power < weakestPower then
                weakestPower = plant.Power
                weakestSlot = slot
            end
        end
        if not weakestSlot then
            break
        end
        if weakestPower >= seed.MaxPower then
            break
        end
        if not ReplacePlant(weakestSlot) then
            break
        end
        UpdatePlantCache()
    end
end

local CONSUMABLES = {
    ["Growth Cocktail"] = true,
    ["Fertilizer"] = true,
    ["Rain"] = true,
    ["Sunlight"] = true,
}

local function UseConsumables()
    for uid, item in pairs(SaveCache.Consumable) do
        if CONSUMABLES[item.id] then
            local tier = tonumber(item.tn) or 1
            local amount = tonumber(item._am) or 1
            if amount > 0 then
                if tier <= 2
                or (tier == 3 and (_G.GardenRebirth or 0) >= 6) then
                    local ok = pcall(function()
                        ConsumeRemote:InvokeServer(uid, 1)
                    end)
                    if ok then
                        task.wait(0.75)
			return
                    end
                end
            end
        end
    end
end

-- MAIN THREAD

local function MainThread()
    while true do
    if not GardenRunning() then
        task.wait(1.5)
        continue
    end
        UpdateSeedInventory()
        if UpdatePlot() then
            if not UpdateUnlockedPlots() then
                if StrongestSeed and InsertSeed(1, StrongestSeed.UID) then
                    WaitCropAppear(1)
                    UpdateUnlockedPlots()
                end
            end
            UpdatePlantCache()
            AutoAcquirePlots()
            AutoCollect()
            UseConsumables()
            AutoReplacePlants()
            UpdatePlantCache()
        end
        task.wait(1)
    end
end

