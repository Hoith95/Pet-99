-- SEED INVENTORY

local SeedInventory = {
    TotalAmount = 0,
    Seeds = {},
}

local VariantPower = {
    Rainbow = 3,
    Shiny = 2,
    Gold = 1,
}

local StrongestSeed

-- UPDATE SEED INVENTORY

local function UpdateSeedInventory()
    table.clear(SeedInventory.Seeds)
    SeedInventory.TotalAmount = 0
    StrongestSeed = nil
    local seeds = SaveCache.CropSeed
    if not seeds then
        return
    end

    for uid, data in pairs(seeds) do
        local info = SeedData[data.id]
        if info then
            local amount = data._am or 1
            SeedInventory.TotalAmount += amount
            SeedInventory.Seeds[#SeedInventory.Seeds + 1] = {
                UID = uid,
                Name = data.id,
                Amount = amount,
                Power = info.Power,
                MaxPower = info.MaxPower,
                Variant = data.vr,
		VariantPower = VariantPower[data.vr] or 0,
            }
        end
    end
    table.sort(SeedInventory.Seeds, function(a, b)
        if a.Power ~= b.Power then
            return a.Power > b.Power
        end
	if a.VariantPower ~= b.VariantPower then
	   return a.VariantPower > b.VariantPower
    	end
        return a.Amount > b.Amount
    end)
    StrongestSeed = SeedInventory.Seeds[1]
end

