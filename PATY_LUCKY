local MiniPinataConsume = ReplicatedStorage.Network.MiniPinata_Consume
local MiniLuckyBlockConsume = ReplicatedStorage.Network.MiniLuckyBlock_Consume
local PartyBoxConsume = ReplicatedStorage.Network.PartyBox_Consume

local function getSave()
    return PlayerSave.Get()
end

local function GetItem(itemId)
    local save = getSave()
    if not save then
        return nil, 0
    end

    local misc = save.Inventory and save.Inventory.Misc
    if not misc then
        return nil, 0
    end

    for uid, item in pairs(misc) do
        if item.id == itemId then
            local amount = tonumber(item._am) or 0
            if amount > 0 then
                return uid, amount
            end
        end
    end

    return nil, 0
end

