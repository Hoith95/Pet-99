if _G.VAR_TIME_TRIAL then
	return
end

_G.VAR_TIME_TRIAL = true
_G.STOP_TIME_TRIAL = false
_G.Time_Trial_End = _G.Time_Trial_End == nil and false or _G.Time_Trial_End

local function TimeTrialRunning()
	return _G.Time_Trial_End == false
end

local function waitUntilTimeTrialEnabled()
	while not TimeTrialRunning() do
		task.wait(1)
	end
end

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer
local Save = require(ReplicatedStorage.Library.Client.Save)
local ZoneCmds = require(ReplicatedStorage.Library.Client.ZoneCmds)

local lagFlag = false
local endFlag = false
local lagMonitorThread, increaseMonitorThread, monitor15minThread

-- 🛡️ Lấy HumanoidRootPart an toàn
local function getHumanoidRootPart()
	local character = player.Character or player.CharacterAdded:Wait()
	if not character then return nil end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	local waitTime = 0
	while not hrp and waitTime < 5 do
		task.wait(0.5)
		waitTime += 0.5
		hrp = character:FindFirstChild("HumanoidRootPart")
	end
	return hrp
end

-- Hàm helper lấy data an toàn, retry tối đa 3 lần rồi trả về mặc định
local function safeFetchSave()
    for i = 1, 3 do
        local ok, data = pcall(Save.Get)
        if ok and data and data.TimeTrialStats then
            return data.TimeTrialStats
        end
        task.wait(1)
    end
    return {
        DailyRuns = 0,
        Points    = 0,
        TotalRuns = 0,
    }
end

-- -> Dùng lại cho tất cả
local function getRunsUsed()
    local stats = safeFetchSave()
    return stats.DailyRuns or 0
end

local function getRunsLeft()
    return 10 - getRunsUsed()
end

local function getTimeTrialPoints()
    local stats = safeFetchSave()
    return stats.Points or 0
end

local function getTotalRuns()
    local stats = safeFetchSave()
    return stats.TotalRuns or 0
end

-- 🗺️ Teleport hỗ trợ
local function teleportTo(part)
	if not TimeTrialRunning() then return end
	local hrp = getHumanoidRootPart()
	if hrp and part and part.CFrame then
		hrp.CFrame = part.CFrame + Vector3.new(0, 8, 0)
	end
end

local function teleportToRewardLocation()
	local hrp = getHumanoidRootPart()
	if hrp then
		hrp.CFrame = CFrame.new(-15079, 16.24, 2165)
	end
end

local function teleportToLocation()
	if not TimeTrialRunning() then return end
	local hrp = getHumanoidRootPart()
	if hrp then
		hrp.CFrame = CFrame.new(-15045, 24.24, 2201)
	end
end

local function safeTeleportOut()
	local exitPosition = CFrame.new(-18438, 16.24, -569)
	local function isTimeTrialActive()
		local things = workspace:FindFirstChild("__THINGS")
		local container = things and things:FindFirstChild("__INSTANCE_CONTAINER")
		local active = container and container:FindFirstChild("Active")
		return active and active:FindFirstChild("TimeTrial") ~= nil
	end
	for _ = 1, 3 do
		local character = player.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if hrp then
			hrp.CFrame = exitPosition
		end
		local elapsed = 0
		while elapsed < 5 do
			if not isTimeTrialActive() then
				if increaseMonitorThread then pcall(task.cancel, increaseMonitorThread) increaseMonitorThread = nil end
				if lagMonitorThread then pcall(task.cancel, lagMonitorThread) lagMonitorThread = nil end
				return true
			end
			task.wait(0.5)
			elapsed += 0.5
		end
	end
	if increaseMonitorThread then pcall(task.cancel, increaseMonitorThread) increaseMonitorThread = nil end
	if lagMonitorThread then pcall(task.cancel, lagMonitorThread) lagMonitorThread = nil end
	return false
end

-- 🔍 Lấy Max Zone từ Map4
local function getMaxZoneFromMap4()
	local mapFolder = workspace:FindFirstChild("Map4")
	if not mapFolder then return 0 end
	local maxZone = 0
	for _, folder in ipairs(mapFolder:GetChildren()) do
		if folder:IsA("Folder") then
			local zoneNumber = tonumber(folder.Name:match("^(%d+)"))
			if zoneNumber and zoneNumber > maxZone then
				maxZone = zoneNumber
			end
		end
	end
	return maxZone
end

-- 🕐 Chờ đến khi đạt Max Zone
local function waitUntilReachMaxZone(useCustomZone)
	waitUntilTimeTrialEnabled()
	local maxMapZone = useCustomZone and 279 or getMaxZoneFromMap4()
	while true do
		waitUntilTimeTrialEnabled()
		local success, data = pcall(function()
			local _, zoneData = ZoneCmds.GetMaxOwnedZone()
			return zoneData
		end)
		local current = success and data and data.ZoneNumber or 0
		if current >= maxMapZone then
			break
		else
			task.wait(60)
		end
	end
end

-- 🧪 Gọi hàm với tùy chọn
waitUntilReachMaxZone(true)  -- Dùng zone cố định 274
--waitUntilReachMaxZone(false) -- Dùng zone lấy từ Map4

-- ⏱️ Monitor 15 phút không tăng lượt/TotalRuns trực tiếp
local function startMonitor15Min()
    monitor15minThread = task.spawn(function()
        local lastUsed   = getRunsUsed()
        local lastPoints = getTimeTrialPoints()
        local timer      = 0
        while true do
            waitUntilTimeTrialEnabled()
            if getRunsUsed() >= 10 then
                return
            end
            task.wait(10)
            if not TimeTrialRunning() then
                continue
            end
            timer = timer + 10
            local curUsed   = getRunsUsed()
            local curPoints = getTimeTrialPoints()
            if curUsed ~= lastUsed or curPoints ~= lastPoints then
                lastUsed   = curUsed
                lastPoints = curPoints
                timer      = 0
            end
            if timer >= 900 then
                player:Kick("⏰ 15 phút không đổi lượt hoặc điểm → nghi ngờ treo máy.")
                return
            end
        end
    end)
end

-- 📌 Theo dõi đứng yên
local function startLagMonitor()
    lagMonitorThread = task.spawn(function()
        local retryCount = 0
        while true do
            waitUntilTimeTrialEnabled()
            local hrp = getHumanoidRootPart()
            if not hrp then
                task.wait(5)
                continue
            end
            local lastPos = hrp.Position
            task.wait(60)
            if not TimeTrialRunning() then
                continue
            end
            local currPos = hrp.Position
            if (lastPos - currPos).Magnitude < 1 then
                retryCount += 1
                if retryCount > 3 then
                    player:Kick("Lag quá lâu trong Time Trial.")
                    return
                else
                    lagFlag = true
                    safeTeleportOut()
                    return
                end
            else
                retryCount = 0
            end
            task.wait(5)
        end
    end)
end

-- 🧠 Theo dõi tăng điểm
local function startIncreaseMonitor(startPoints, startRuns)
    increaseMonitorThread = task.spawn(function()
        while true do
            waitUntilTimeTrialEnabled()
            if lagFlag then
                return
            end
            local ok, data = pcall(Save.Get)
            local stats = ok and data and data.TimeTrialStats
            local currentPoints = tonumber(stats and stats.Points) or 0
            local currentRuns = tonumber(stats and stats.TotalRuns) or 0
            if currentPoints > startPoints
                or currentRuns > startRuns then
                endFlag = true
                return
            end
            task.wait(0.5)
        end
    end)
end

-- 🔁 Teleport farm breakables
local function teleportFarmLoop(startPoints, startRuns)
	while true do
		waitUntilTimeTrialEnabled()
		if lagFlag or endFlag or _G.STOP_TIME_TRIAL then
			return
		end
		local timeTrial = workspace.__THINGS.__INSTANCE_CONTAINER.Active:FindFirstChild("TimeTrial")
		local breakZones = timeTrial and timeTrial:FindFirstChild("BREAK_ZONES")
		if not breakZones then
			task.wait(1)
			continue
		end
		local zones = breakZones:GetChildren()
		if #zones == 0 then
			task.wait(1)
			continue
		end
		for i = 1, math.min(6, #zones) do
			if not TimeTrialRunning() or lagFlag or endFlag or _G.STOP_TIME_TRIAL then
				return
			end
			local zone = zones[i]
			if zone and zone:IsA("BasePart") then
				local hrp = getHumanoidRootPart()
				if hrp then
					hrp.CFrame = zone.CFrame
				end
			end
			task.wait(1)
		end
	end
end

-- 🎁 Đổi quà
local function claimReward()
    local points = getTimeTrialPoints()
    local now = os.date("!*t", os.time(os.date("!*t")) + 7 * 3600)
    local currentDay = now.wday
    local currentHour = now.hour
    local isSaturdayFull = (currentDay == 3) and (currentHour < 23)
    local chest3, chest2, chest1 = 0, 0, 0
    if isSaturdayFull then
        chest3 = math.floor(points / 5000)
        points = points - chest3 * 5000
        chest2 = math.floor(points / 3000)
        points = points - chest2 * 3000
        chest1 = math.floor(points / 1000)
    else
        chest3 = math.floor(points / 5000)
    end
    local totalChests = chest3 + chest2 + chest1
    if totalChests == 0 then
        return
    end
    local function openChest(chestType)
        local args = { [1] = chestType }
        return ReplicatedStorage.Network.TimeTrials_OpenChest:InvokeServer(unpack(args))
    end
    local function isAtExactRewardPosition()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end
        local target = Vector3.new(-15079, 16.24, 2165)
        return (hrp.Position - target).Magnitude <= 2
    end
    local function claimMultiple(count, chestType)
        for i = 1, count do
            local success, err = pcall(function()
                openChest(chestType)
            end)
            if success then
            else
            end
            task.wait(3)
            if not isAtExactRewardPosition() then
                teleportToRewardLocation()
                task.wait(3)
                if not isAtExactRewardPosition() then
                else
                end
            end
        end
    end
    local retry = 0
    while retry < 3 do
        retry += 1
        teleportToRewardLocation()
        task.wait(3)
        if isAtExactRewardPosition() then
            break
        else
        end
    end
    if not isAtExactRewardPosition() then
        return
    end
    claimMultiple(chest3, 3)
    claimMultiple(chest2, 2)
    claimMultiple(chest1, 1)
    task.wait(3)
    teleportToLocation()
end

-- 🔄 Auto-claim song song, chạy mỗi 15 phút
local function startAutoClaim()
    task.spawn(function()
        while true do
            waitUntilTimeTrialEnabled()
            task.wait(15 * 60)
            if not TimeTrialRunning() then
                continue
            end
            local pts = getTimeTrialPoints()
            local d = os.date("!*t", os.time(os.date("!*t")) + 7 * 3600)
            local can = (d.wday == 3 and d.hour < 23 and pts >= 1000)
                    or (d.wday ~= 3 and pts >= 5000)
            if can then
                claimReward()
            else
            end
        end
    end)
end

-- ===========- WAIT UNTIL EGGS HATCHED INCREASES -===========

local function getEggsHatched()
	local ok, data = pcall(Save.Get)
	if not ok or not data then
		return nil
	end
	return tonumber(data.EggsHatched) or 0
end
local lastEggs
repeat
	lastEggs = getEggsHatched()
	task.wait(1)
until lastEggs ~= nil
local function waitUntilEggsHatchedIncreases()
	repeat
		task.wait(1)
		local currentEggs = getEggsHatched()
		if currentEggs and currentEggs > lastEggs then
			lastEggs = currentEggs
			break
		end
	until false
end

-- ✅ VÒNG LẶP CHÍNH
task.spawn(function()
    waitUntilTimeTrialEnabled()
    waitUntilReachMaxZone(true)
    startMonitor15Min()
    waitUntilEggsHatchedIncreases()
    while true do
        while true do
            local used = getRunsUsed()
            if used >= 10 then
                break
            end
            waitUntilTimeTrialEnabled()
            used = getRunsUsed()
            if used >= 10 then
                break
            end
            lagFlag = false
            endFlag = false
            if used > 0 then
                task.wait(30)
                if not TimeTrialRunning() then
                    continue
                end
            end
            waitUntilTimeTrialEnabled()
            local startPoints = getTimeTrialPoints()
            local startRuns = getTotalRuns()
            waitUntilTimeTrialEnabled()
            local character = player.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            if not hrp then
                task.wait(3)
                continue
            end
            hrp.CFrame = CFrame.new(-15114, 16.24, 2221)
            task.wait(5)
            if not TimeTrialRunning() then
                continue
            end
            local retry = 0
            while TimeTrialRunning()
                and not workspace.__THINGS.__INSTANCE_CONTAINER.Active:FindFirstChild("TimeTrial")
                and retry < 3 do
                retry += 1
                local root = player.Character
                    and player.Character:FindFirstChild("HumanoidRootPart")
                if root then
                    root.CFrame = CFrame.new(-15114, 16.24, 2221)
                end
                task.wait(5)
            end
            if not TimeTrialRunning() then
                continue
            end
            if not workspace.__THINGS.__INSTANCE_CONTAINER.Active:FindFirstChild("TimeTrial") then
                return
            end
            startLagMonitor()
            startIncreaseMonitor(startPoints, startRuns)
            teleportFarmLoop(startPoints, startRuns)
            if endFlag or lagFlag or getRunsUsed() >= 10 or not TimeTrialRunning() then
                safeTeleportOut()
            end
            task.wait(5)
            if lagMonitorThread then
                pcall(task.cancel, lagMonitorThread)
                lagMonitorThread = nil
            end
            if increaseMonitorThread then
                pcall(task.cancel, increaseMonitorThread)
                increaseMonitorThread = nil
            end
        end
        claimReward()
        task.wait(60)
        _G.Time_Trial_Done = true
        _G.Time_Trial_End = true
        while not TimeTrialRunning() do
            task.wait(60)
        end
        if monitor15minThread then
            pcall(task.cancel, monitor15minThread)
            monitor15minThread = nil
        end
        task.wait(5)
        startMonitor15Min()
    end
end)
