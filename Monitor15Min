if _G.MONITOR_15MIN_RUNNING then return end
_G.MONITOR_15MIN_RUNNING = true

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService        = game:GetService("RunService")
local Save              = require(ReplicatedStorage.Library.Client.Save)

local player = Players.LocalPlayer

local function getRunsUsed()
    local sd = Save.Get()
    return (sd and sd.TimeTrialStats and sd.TimeTrialStats.DailyRuns) or 0
end

local function getTotalRuns()
    local sd = Save.Get()
    return (sd and sd.TimeTrialStats and sd.TimeTrialStats.TotalRuns) or 0
end

local function isInTimeTrial()
    local things = workspace:FindFirstChild("__THINGS")
    if not things then
        return false
    end

    local container = things:FindFirstChild("__INSTANCE_CONTAINER")
    if not container then
        return false
    end

    local active = container:FindFirstChild("Active")
    if not active then
        return false
    end

    return active:FindFirstChild("TimeTrial") ~= nil
end

local function startMonitor15Min()
    local lastUsed  = getRunsUsed()
    local lastTotal = getTotalRuns()

    local timer = 0
    local timeTrialTimer = 0

    RunService.Heartbeat:Connect(function(dt)
        local curUsed  = getRunsUsed()
        local curTotal = getTotalRuns()

        if curUsed >= 10 then
            if isInTimeTrial() then
                timeTrialTimer = timeTrialTimer + dt

                if timeTrialTimer >= 1200 then
                    player:Kick("Đã đủ 10 lượt nhưng vẫn còn trong Time Trial quá 20 phút.")
                end
            else
                timeTrialTimer = 0
            end

            return
        end

        timeTrialTimer = 0

        if curUsed ~= lastUsed or curTotal ~= lastTotal then
            lastUsed  = curUsed
            lastTotal = curTotal
            timer = 0
        end

        timer = timer + dt

        if timer >= 1200 then
            player:Kick("20 phút không đổi lượt/TotalRuns → nghi ngờ treo máy.")
        end
    end)
end

startMonitor15Min()
